rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Must match FINANCE_EMAIL in index.html
    function isFinance() {
      return request.auth != null && request.auth.token.email == 'megm-finance@megm-budget.app';
    }

    // Encrypted budget summary: anyone can read (it's unreadable without the club password)
    match /club/summary {
      allow read: if true;
      allow write: if isFinance();
    }

    // Encrypted ledger: finance account only
    match /finance/{doc} {
      allow read, write: if isFinance();
    }

    // Proposals: anyone can submit a new one; only finance can read or delete
    match /proposals/{id} {
      allow create: if request.resource.data.keys().hasOnly(['created', 'wk', 'iv', 'ct'])
                    && request.resource.data.wk is string
                    && request.resource.data.iv is string
                    && request.resource.data.ct is string
                    && request.resource.data.ct.size() < 200000;
      allow read, delete: if isFinance();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
